{
  "name": "otterwelt",
  "version": "0.6.0",
  "private": true,
  "description": "Otterwelt – ein kleines Spiel",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node scripts/e2e.mjs",
